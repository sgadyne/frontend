{
  "name": "@analysis/workspaces",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "node --experimental-strip-types tests/check-browser.mjs",
    "test:cluster-browser": "node --experimental-strip-types tests/check-cluster-browser.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@sampo/contracts": "0.2.0-alpha.20261031.1",
    "@sampo/sdk-react": "0.2.0-alpha.20261031.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "esbuild": "0.28.1",
    "playwright": "1.61.1"
  }
}
