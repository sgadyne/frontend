    "@sampo/sdk-react": "file:vendor/sampo-sdk-v2-bed3234/sampo-sdk-react-0.2.0-alpha.20261031.1.tgz",
    "@sampo/tooling": "file:vendor/sampo-sdk-v2-bed3234/sampo-tooling-0.2.0-alpha.20261031.1.tgz",
    "ag-grid-community": "34.1.2",
    "ag-grid-react": "34.1.2",
    "motion": "14.9.0",
    "plotly.js-gl3d-dist-min": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@sampo/client": "file:vendor/sampo-sdk-v2-bed3234/sampo-client-0.2.0-alpha.20261031.1.tgz",
    "@sampo/design-tokens": "file:vendor/sampo-sdk-v2-bed3234/sampo-design-tokens-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "playwright": "1.61.1",
