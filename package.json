{
  "name": "frontend",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc -p apps/pod-risk-lens/tsconfig.json && node node_modules/typescript/bin/tsc -p apps/vfo-operations/tsconfig.json",
    "build:vfo": "npm --prefix packages/vfo-workspace-core run build",
    "build:risk": "node scripts/build-risk.mjs",
    "build:risk:demo": "node node_modules/vite/bin/vite.js build --config apps/risk-lens-demo/vite.config.mjs",
    "build": "npm run typecheck && npm run build:risk && npm run build:vfo && npm run build:analysis",
    "test": "node --test --test-isolation=none apps/pod-risk-lens/tests/*.test.mjs packages/risk-lens-data/*.test.mjs packages/vfo-workspace-core/tests/*.test.mjs",
    "demo": "node node_modules/vite/bin/vite.js --config apps/workspace-demo/vite.config.mjs",
    "build:demo": "node node_modules/vite/bin/vite.js build --config apps/workspace-demo/vite.config.mjs",
    "audit:boundary": "node scripts/audit-public.mjs",
    "typecheck:analysis": "node node_modules/typescript/bin/tsc -p packages/analysis-workspaces/tsconfig.json",
    "build:analysis": "npm --prefix packages/analysis-workspaces run build",
    "test:analysis": "node --experimental-strip-types --test --test-isolation=none packages/analysis-workspaces/tests/*.test.mjs",
    "demo:risk": "node node_modules/vite/bin/vite.js --config apps/risk-lens-demo/vite.config.mjs",
    "preview:risk": "node node_modules/vite/bin/vite.js preview --config apps/risk-lens-demo/vite.config.mjs",
    "check": "npm run audit:boundary && npm run typecheck && npm run typecheck:analysis && npm test && npm run test:analysis",
    "test:risk-browser": "node scripts/check-risk-demo.mjs",
    "demo:analysis": "node node_modules/vite/bin/vite.js --config apps/analysis-demo/vite.config.mjs",
    "build:analysis-demo": "node node_modules/vite/bin/vite.js build --config apps/analysis-demo/vite.config.mjs",
    "typecheck:analysis-demo": "node node_modules/typescript/bin/tsc -p apps/analysis-demo/tsconfig.json",
    "test:appearance": "node scripts/check-appearance-demo.mjs",
    "test:shell-browser": "node scripts/check-shell-interactions.mjs",
    "test:optics": "node scripts/check-optical-preview.mjs"
  },
  "dependencies": {
    "@sampo/contracts": "https://github.com/sgadyne/sampo/releases/download/v1.0.0-beta.2/sampo-contracts-0.2.0-alpha.20261102.1.tgz",
    "@sampo/runtime": "https://github.com/sgadyne/sampo/releases/download/v1.0.0-beta.2/sampo-runtime-0.2.0-alpha.20261102.1.tgz",
    "@sampo/sdk-react": "https://github.com/sgadyne/sampo/releases/download/v1.0.0-beta.2/sampo-sdk-react-0.2.0-alpha.20261102.1.tgz",
    "@sampo/tooling": "https://github.com/sgadyne/sampo/releases/download/v1.0.0-beta.2/sampo-tooling-0.2.0-alpha.20261102.1.tgz",
    "ag-grid-community": "34.1.2",
    "ag-grid-react": "34.1.2",
    "motion": "14.9.0",
    "plotly.js-gl3d-dist-min": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@sampo/client": "https://github.com/sgadyne/sampo/releases/download/v1.0.0-beta.2/sampo-client-0.2.0-alpha.20261102.1.tgz",
    "@sampo/design-tokens": "https://github.com/sgadyne/sampo/releases/download/v1.0.0-beta.2/sampo-design-tokens-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "license": "UNLICENSED",
  "exports": {
    "./package.json": "./package.json",
    "./risk/session": "./apps/pod-risk-lens/src/features/risk-lens/session.ts",
    "./risk/presentation": "./apps/pod-risk-lens/src/features/risk-lens/presentation.ts",
    "./risk/session-widgets": "./apps/pod-risk-lens/src/features/risk-lens/sessionWidgets.tsx",
    "./risk/application-widget": "./apps/pod-risk-lens/src/App.tsx",
    "./risk/types": "./apps/pod-risk-lens/src/domain/types.ts",
    "./risk/format": "./apps/pod-risk-lens/src/domain/format.ts",
    "./risk/exposure-table": "./apps/pod-risk-lens/src/components/ExposureTable.tsx",
    "./risk/styles.css": "./apps/pod-risk-lens/src/styles.css",
    "./risk/provider-contracts": "./packages/risk-lens-data/contracts.ts",
    "./vfo/extension": "./packages/vfo-workspace-core/src/extension.tsx",
    "./vfo/http-provider": "./packages/vfo-workspace-core/src/data/http-provider.mjs",
    "./analysis": "./packages/analysis-workspaces/src/index.tsx",
    "./analysis/reports": "./packages/analysis-workspaces/src/replication/reports.ts",
    "./build/scope-widget-css": "./scripts/scope-widget-css.mjs",
    "./market-universe/catalog.json": "./assets/market-universe/catalog.json",
    "./market-universe/groups.json": "./assets/market-universe/groups.json",
    "./market-universe/logos/*": "./assets/market-universe/logos/*",
    "./presentation": "./packages/presentation/src/index.tsx",
    "./presentation/core": "./packages/presentation/src/core.tsx",
    "./market-universe/navigation.json": "./assets/market-universe/navigation.json",
    "./market-universe/workbench": "./packages/vfo-workspace-core/src/market/UniverseWorkbench.tsx",
    "./market-universe/model": "./packages/vfo-workspace-core/src/market/universe-model.ts"
  },
  "files": [
    "assets/market-universe",
    "apps/pod-risk-lens/src",
    "packages/risk-lens-data",
    "packages/vfo-workspace-core/src",
    "packages/analysis-workspaces/src",
    "scripts/scope-widget-css.mjs",
    "LICENSE",
    "packages/presentation/src"
  ]
}
