{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "VfoMarket.tsx",
    "market-universe-data.ts"
  ]
}
